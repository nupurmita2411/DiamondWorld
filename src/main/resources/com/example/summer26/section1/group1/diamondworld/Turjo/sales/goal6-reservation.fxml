<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.ReservationController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
        <Label text="Goal 6: Reserve Jewellery Items for VIP Clients" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <Separator/>
    <VBox spacing="8">
        <GridPane hgap="8" vgap="8">
            <Label text="Item Tag / Barcode:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="itemTagField" promptText="DW-RING-001" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="VIP Customer ID:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="customerIdField" promptText="C001" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <Button text="Confirm 48-Hour Hold Reservation" onAction="#onReserve" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Separator/>
        <Label text="Active VIP Item Hold Reservations (Double-click table cells to edit):" style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
        <TableView fx:id="reservationTable" prefHeight="160" editable="true">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="80"/>
                <TableColumn fx:id="tagCol" text="Item Tag" prefWidth="130"/>
                <TableColumn fx:id="custCol" text="Customer ID" prefWidth="110"/>
                <TableColumn fx:id="expiryCol" text="Expiry Time" prefWidth="140"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
            </columns>
        </TableView>

        <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
            <Label text="Edit / Add Reservation Row:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <HBox spacing="8">
                <Button text="Add Reservation Row" onAction="#onAddRow" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Update Row" onAction="#onUpdateRow" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Delete Row" onAction="#onDeleteRow" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight: bold;"/>
</VBox>
