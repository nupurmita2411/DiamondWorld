<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.summer26.section1.group1.diamondworld.LoginController"
      alignment="CENTER" spacing="16">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <VBox alignment="CENTER" maxWidth="420" spacing="4">
        <Label text="DIAMOND WORLD" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label text="Jewellery Shop Management System" style="-fx-font-size: 14px;"/>
    </VBox>

    <VBox spacing="12" maxWidth="420" alignment="CENTER_LEFT">
        <Label text="Employee Login" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="Employee ID (7-digit)"/>
        <TextField fx:id="employeeIdField" promptText="e.g. 2120049" maxWidth="Infinity"/>
        <Label text="Password"/>
        <PasswordField fx:id="passwordField" promptText="Min 6 chars, letters + digits" maxWidth="Infinity"/>
        <Label fx:id="errorLabel" style="-fx-text-fill: red;" wrapText="true"/>
        <HBox spacing="10" alignment="CENTER">
            <Button text="Login" onAction="#onLogin" defaultButton="true"/>
        </HBox>
        <Separator/>
        <Label text="Demo Accounts:" style="-fx-font-weight: bold;"/>
        <Label text="Branch Manager: 2120049 / bm123456" wrapText="true"/>
        <Label text="Sales Executive: 2310973 / se123456" wrapText="true"/>
    </VBox>
</VBox>

