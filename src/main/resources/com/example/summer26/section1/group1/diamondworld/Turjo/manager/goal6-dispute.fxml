<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.controller.manager.DisputeController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8">
        <Button text="Back" onAction="#onBack"/>
        <Label text="Goal 6: Handle Dispute Escalations" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <VBox spacing="8">
        <HBox spacing="8">
            <Label text="Phone:"/>
            <TextField fx:id="phoneField" promptText="01712345678"/>
            <Label text="Invoice:"/>
            <TextField fx:id="invoiceField" promptText="INV-2026-0142"/>
            <Button text="Search Dispute" onAction="#onSearch"/>
        </HBox>
        <TextArea fx:id="detailsArea" prefRowCount="6" editable="false"/>
        <HBox spacing="8">
            <Label text="Resolution:"/>
            <ComboBox fx:id="resolutionCombo" prefWidth="200"/>
            <Button text="Settle Dispute" onAction="#onResolve"/>
        </HBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>

