<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="514.0" prefWidth="629.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.summer26.section1.group1.diamondworld.Nupur.user7goal3">
    <children>

        <!-- event-3: TextFields for Supplier ID, Name, Contact, Email -->
        <TextField fx:id="txtSupplierId" layoutX="40.0" layoutY="84.0" prefWidth="180.0" promptText="Supplier ID" AnchorPane.leftAnchor="40.0" />
        <TextField fx:id="txtSupplierName" layoutX="240.0" layoutY="84.0" prefWidth="180.0" promptText="Supplier Name" AnchorPane.leftAnchor="240.0" />
        <TextField fx:id="txtContactNumber" layoutX="40.0" layoutY="124.0" prefWidth="180.0" promptText="Contact Number" AnchorPane.leftAnchor="40.0" />
        <TextField fx:id="txtEmailAddress" layoutX="240.0" layoutY="124.0" prefWidth="180.0" promptText="Email Address" AnchorPane.leftAnchor="240.0" />

        <!-- event-4: TextArea for Supplier Address -->
        <TextArea fx:id="txtSupplierAddress" layoutX="440.0" layoutY="84.0" prefHeight="60.0" prefWidth="145.0" promptText="Supplier Address" AnchorPane.leftAnchor="440.0" />

        <!-- event-5 & event-7: Action Buttons -->
        <Button layoutX="40.0" layoutY="184.0" mnemonicParsing="false" onAction="#btnAddSupplier" text="Add Supplier" AnchorPane.leftAnchor="40.0" />
        <Button layoutX="150.0" layoutY="184.0" mnemonicParsing="false" onAction="#btnUpdateSupplier" text="Update Supplier" AnchorPane.leftAnchor="150.0" />
        <Button layoutX="270.0" layoutY="184.0" mnemonicParsing="false" onAction="#btnDeleteSupplier" text="Delete Supplier" AnchorPane.leftAnchor="270.0" />

        <!-- event-6: TableView for Supplier List -->
        <TableView fx:id="tblSuppliers" layoutX="40.0" layoutY="234.0" prefHeight="220.0" prefWidth="620.0" style="-fx-border-color: #9a65f0;" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="180.0" text="Name" />
                <TableColumn fx:id="colContact" prefWidth="148.6666259765625" text="Contact" />
                <TableColumn fx:id="colStatus" prefWidth="118.66671752929688" text="Status" />
            </columns>
        </TableView>

        <!-- event-7: Confirmation Status Label -->
        <Label fx:id="Status" layoutX="54.0" layoutY="464.0" prefHeight="44.0" prefWidth="401.0" AnchorPane.leftAnchor="54.0" />

        <!-- event-8: Return Home Button -->
        <Button layoutX="506.0" layoutY="468.0" mnemonicParsing="false" onAction="#btnReturnHome" text="Return Home" AnchorPane.leftAnchor="506.0" />
      <Label layoutX="72.0" layoutY="29.0" text="Supplier Management " textFill="#2C3E50">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

    </children>
</AnchorPane>
