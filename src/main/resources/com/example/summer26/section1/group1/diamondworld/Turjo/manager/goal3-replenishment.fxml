<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.controller.manager.ReplenishmentController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8">
        <Button text="Back" onAction="#onBack"/>
        <Label text="Goal 3: Stock Replenishment Authorization" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <VBox spacing="8">
        <Button text="Open Replenishment Console" onAction="#onOpenConsole"/>
        <TableView fx:id="alertTable" prefHeight="120">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="80"/>
                <TableColumn fx:id="typeCol" text="Item Type" prefWidth="150"/>
                <TableColumn fx:id="stockCol" text="Current Stock" prefWidth="100"/>
            </columns>
        </TableView>
        <HBox spacing="8">
            <Label text="Request:"/>
            <ComboBox fx:id="requestCombo" prefWidth="200"/>
            <Label text="Auth Code:"/>
            <TextField fx:id="authCodeField" promptText="AUTH1234"/>
            <Button text="Authorize" onAction="#onAuthorize"/>
        </HBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>

