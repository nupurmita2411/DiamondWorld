<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.ReplenishmentController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
        <Label text="Goal 3: Stock Replenishment Authorization" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <Separator/>
    <VBox spacing="8">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="Open Console" onAction="#onOpenConsole"/>
            <Label text="Request:"/>
            <ComboBox fx:id="requestCombo" prefWidth="180"/>
            <Label text="Auth Code:"/>
            <TextField fx:id="authCodeField" prefWidth="90" promptText="AUTH1234"/>
            <Button text="Authorize" onAction="#onAuthorize" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>

        <Label text="Low-Stock Replenishment Items (Double-click cells to edit):" style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
        <TableView fx:id="alertTable" prefHeight="180" editable="true">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="90"/>
                <TableColumn fx:id="typeCol" text="Item Type" prefWidth="160"/>
                <TableColumn fx:id="stockCol" text="Current Stock" prefWidth="110"/>
                <TableColumn fx:id="reqQtyCol" text="Requested Qty" prefWidth="120"/>
            </columns>
        </TableView>

        <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
            <Label text="Edit / Add Replenishment Row:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <GridPane hgap="8" vgap="6">
                <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="idInput" promptText="e.g. REP-101" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Item Type:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="typeInput" promptText="e.g. Gold Chains" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Current Stock:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="stockInput" promptText="e.g. 3" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Req Qty:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="reqQtyInput" promptText="e.g. 10" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </GridPane>
            <HBox spacing="8">
                <Button text="Add Row" onAction="#onAddRow" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Update Row" onAction="#onUpdateRow" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Delete Row" onAction="#onDeleteRow" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight: bold;"/>
</VBox>
