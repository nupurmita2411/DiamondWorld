<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.DailySalesController">

    <!-- Top Section: Header Title & Return Home Button (Event-8) -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 0 20;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnReturnHome" mnemonicParsing="false" onAction="#handleReturnHome" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="← Return Home" />
                <Label text="Daily Sales Transactions Dashboard" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- Center Section: Filters, Table View & Summary Cards -->
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>

                <!-- Filters Bar (Event-3) -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #ecf0f1; -fx-padding: 12; -fx-background-radius: 5;">
                    <children>
                        <Label text="Sales Date:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <DatePicker fx:id="dpSalesDate" prefWidth="150.0" promptText="Select Date" />

                        <Label text="Payment Method:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbPaymentMethod" prefWidth="140.0" promptText="All Methods" />

                        <Label text="Invoice Status:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbInvoiceStatus" prefWidth="130.0" promptText="All Status" />

                        <Button fx:id="btnFilterSales" mnemonicParsing="false" onAction="#handleFilterSales" prefHeight="30.0" prefWidth="110.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="Apply Filter" />
                    </children>
                </HBox>

                <!-- TableView to Display Sales Transactions (Event-7) -->
                <TableView fx:id="tableDailySales" prefHeight="330.0" prefWidth="910.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colInvoiceNo" prefWidth="140.0" text="Invoice No" />
                        <TableColumn fx:id="colCustomer" prefWidth="200.0" text="Customer" />
                        <TableColumn fx:id="colPaymentMethod" prefWidth="150.0" text="Payment Method" />
                        <TableColumn fx:id="colTrxTime" prefWidth="160.0" text="Transaction Time" />
                        <TableColumn fx:id="colAmount" prefWidth="150.0" text="Amount (BDT)" />
                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Summary Section Area (Event-6 & Event-7) -->
                <GridPane hgap="15.0" style="-fx-background-color: #f8f9fa; -fx-padding: 12; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="25.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="25.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label fx:id="lblTotalTrxCount" text="Total Transactions: 0" textFill="#2c3e50" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalSalesAmount" text="Total Sales: 0.00 BDT" textFill="#27ae60" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalPaidAmount" text="Total Paid: 0.00 BDT" textFill="#2980b9" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>

                        <Label fx:id="lblTotalDiscount" text="Total Discount: 0.00 BDT" textFill="#7f8c8d" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalTax" text="Total Tax: 0.00 BDT" textFill="#7f8c8d" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblCancelledAmount" text="Cancelled Amount: 0.00 BDT" textFill="#c0392b" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </GridPane>

            </children>
        </VBox>
    </center>
</BorderPane>

