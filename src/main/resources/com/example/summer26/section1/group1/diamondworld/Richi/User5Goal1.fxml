<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.summer26.section1.group1.diamondworld.Richi.User5Goal1">
    <children>

        <!-- Top Header Bar -->
        <AnchorPane prefHeight="60.0" style="-fx-background-color: #2c3e50;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Button fx:id="btnReturnHome" layoutX="20.0" layoutY="16.0" mnemonicParsing="false" onAction="#handleReturnHome" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="← Return Home" />
                <Label layoutX="160.0" layoutY="17.0" text="Billing Management - Generate Invoice" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Button fx:id="signOutTextField" layoutX="797.0" layoutY="18.0" mnemonicParsing="false" onAction="#signOutOnButtonClick" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="← Sign Out" />
            </children>
        </AnchorPane>

        <!-- Input Form Fields -->
        <Label layoutX="20.0" layoutY="85.0" text="Customer ID:" />
        <TextField fx:id="txtCustomerID" layoutX="110.0" layoutY="80.0" prefWidth="150.0" promptText="Enter ID" />

        <Label layoutX="280.0" layoutY="85.0" text="Phone:" />
        <TextField fx:id="txtCustomerPhone" layoutX="330.0" layoutY="80.0" prefWidth="150.0" promptText="Enter Phone" />

        <Label layoutX="20.0" layoutY="125.0" text="Product Code:" />
        <TextField fx:id="txtProductCode" layoutX="110.0" layoutY="120.0" prefWidth="150.0" promptText="Enter Code" />

        <Label layoutX="280.0" layoutY="125.0" text="Quantity:" />
        <TextField fx:id="txtProductQuantity" layoutX="330.0" layoutY="120.0" prefWidth="150.0" promptText="Enter Qty" />

        <Button fx:id="btnAddProduct" layoutX="500.0" layoutY="120.0" mnemonicParsing="false" onAction="#handleAddProduct" prefWidth="120.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Add Product" />

        <!-- Table View Section -->
        <TableView fx:id="billingTableV" layoutX="20.0" layoutY="170.0" prefHeight="370.0" prefWidth="860.0" AnchorPane.bottomAnchor="110.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="170.0">
            <columns>
                <TableColumn fx:id="colProductCode" prefWidth="150.0" text="Product Code" />
                <TableColumn fx:id="colProductName" prefWidth="250.0" text="Product Name" />
                <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Quantity" />
                <TableColumn fx:id="colUnitPrice" prefWidth="150.0" text="Unit Price (BDT)" />
                <TableColumn fx:id="colSubtotal" prefWidth="180.0" text="Subtotal (BDT)" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Totals & Generate Invoice Section (Bottom) -->
        <Label fx:id="lblSubTotal" layoutX="480.0" layoutY="555.0" text="Subtotal: 0.00 BDT" AnchorPane.bottomAnchor="75.0" AnchorPane.rightAnchor="220.0">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
        <Label fx:id="lblTaxDiscount" layoutX="480.0" layoutY="575.0" text="Tax/Discount: 0.00 BDT" AnchorPane.bottomAnchor="55.0" AnchorPane.rightAnchor="220.0">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
        <Label fx:id="lblFinalTotal" layoutX="480.0" layoutY="598.0" text="Final Total: 0.00 BDT" textFill="#c0392b" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="220.0">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <Button fx:id="btnGenerateInvoice" layoutX="700.0" layoutY="560.0" mnemonicParsing="false" onAction="#handleGenerateInvoice" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="Generate Invoice" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="20.0" />

    </children>
</AnchorPane>
