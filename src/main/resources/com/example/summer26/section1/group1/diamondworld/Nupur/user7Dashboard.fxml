<AnchorPane prefHeight="550.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.summer26.section1.group1.diamondworld.Nupur.Use7Dashboard">
    <children>

        <!-- Title Header -->
        <Label layoutX="140.0" layoutY="25.0" text="Inventory Manager Dashboard" textFill="#2C3E50">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Goal-1 Button -->
        <Button layoutX="125.0" layoutY="80.0" mnemonicParsing="false" onAction="#btnGoal1OnClick" prefHeight="35.0" prefWidth="350.0" text="Product Stock Management" />

        <!-- Goal-2 Button -->
        <Button layoutX="125.0" layoutY="130.0" mnemonicParsing="false" onAction="#btnGoal2OnClick" prefHeight="35.0" prefWidth="350.0" text="Stock Reorder Alerting" />

        <!-- Goal-3 Button -->
        <Button layoutX="125.0" layoutY="180.0" mnemonicParsing="false" onAction="#btnGoal3OnClick" prefHeight="35.0" prefWidth="350.0" text="Branch Inventory Transfer" />

