<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.CampaignAnalyticsController">

    <!-- Top Section: Header Title & Return Home Button (Event-8) -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 0 20;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnReturnHome" mnemonicParsing="false" onAction="#handleReturnHome" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="← Return Home" />
                <Label text="Campaign Analytics Dashboard - Performance Analysis" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- Center Section: Filters, Summary Cards, TableView & Charts -->
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>

                <!-- Filters Bar (Event-3) -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #ecf0f1; -fx-padding: 12; -fx-background-radius: 5;">
                    <children>
                        <Label text="Select Campaign:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbCampaign" prefWidth="180.0" promptText="Choose Campaign" />

                        <Label text="Start Date:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <DatePicker fx:id="dpStartDate" prefWidth="140.0" promptText="Select Start" />

                        <Label text="End Date:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <DatePicker fx:id="dpEndDate" prefWidth="140.0" promptText="Select End" />

                        <Button fx:id="btnAnalyze" mnemonicParsing="false" onAction="#handleAnalyze" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="Analyze Data" />
                    </children>
                </HBox>

                <!-- Key Performance Metrics Summary Cards (Event-7) -->
                <GridPane hgap="15.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label fx:id="lblTotalRevenue" text="Revenue: 0.00 BDT" textFill="#27ae60" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalOrders" text="Total Orders: 0" textFill="#2980b9" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblConversionRate" text="Conversion: 0.0%" textFill="#8e44ad" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblCouponUsage" text="Coupons Used: 0" textFill="#d35400" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </GridPane>

                <!-- TabPane: TableView and Visual Chart Display (Event-7) -->
                <TabPane prefHeight="330.0" prefWidth="910.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>

                        <!-- Tab 1: Detailed Analytics Table -->
                        <Tab text="Performance Data Table">
                            <content>
                                <VBox spacing="10.0">
                                    <padding>
                                        <Insets top="10.0" />
                                    </padding>
                                    <children>
                                        <TableView fx:id="tableCampaignMetrics" prefHeight="260.0" prefWidth="910.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colMetricName" prefWidth="200.0" text="Metric Parameter" />
                                                <TableColumn fx:id="colEngagement" prefWidth="150.0" text="Engagement / Reach" />
                                                <TableColumn fx:id="colConversions" prefWidth="150.0" text="Conversions" />
                                                <TableColumn fx:id="colOrders" prefWidth="150.0" text="Orders Placed" />
                                                <TableColumn fx:id="colRevenue" prefWidth="240.0" text="Generated Revenue (BDT)" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                        <!-- Tab 2: Visual Performance Chart -->
                        <Tab text="Performance Chart">
                            <content>
                                <VBox alignment="CENTER">
                                    <children>
                                        <BarChart fx:id="chartPerformance" prefHeight="260.0" prefWidth="910.0" VBox.vgrow="ALWAYS">
                                            <xAxis>
                                                <CategoryAxis label="Campaign Metrics" side="BOTTOM" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis label="Value / Revenue" side="LEFT" />
                                            </yAxis>
                                        </BarChart>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                    </tabs>
                </TabPane>

            </children>
        </VBox>
    </center>
</BorderPane>
