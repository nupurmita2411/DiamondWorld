<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.controller.manager.SalesReportController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8">
        <Button text="Back" onAction="#onBack"/>
        <Label text="Goal 2: Monthly Sales Revenue Report" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <VBox spacing="8">
        <HBox spacing="8">
            <Label text="Month:"/>
            <TextField fx:id="monthField" prefWidth="60" promptText="6"/>
            <Label text="Year:"/>
            <TextField fx:id="yearField" prefWidth="80" promptText="2026"/>
            <Button text="Generate Report" onAction="#onGenerate"/>
        </HBox>
        <TextArea fx:id="reportArea" prefRowCount="10" editable="false"/>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>

