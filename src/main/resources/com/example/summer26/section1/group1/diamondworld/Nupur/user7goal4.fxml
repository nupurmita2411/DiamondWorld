<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="685.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.summer26.section1.group1.diamondworld.Nupur.User7goal4">
    <children>


        <Label layoutX="112.0" layoutY="14.0" prefHeight="17.0" prefWidth="516.0" text="Purchase Order Management" AnchorPane.leftAnchor="112.0" AnchorPane.topAnchor="14.0">
         <font>
            <Font size="27.0" />
         </font>
         <textFill>
            <LinearGradient endX="1.0" endY="1.0" startX="0.19873817034700314" startY="0.43217666818516487">
               <stops>
                  <Stop>
                     <color>
                        <Color />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="0.006172839552164078" green="0.08641975373029709" blue="0.1666666716337204" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </textFill></Label>

        <!-- event-4: TableView showing products with columns: Product ID, Product Name, Quantity, Cost -->
        <TableView fx:id="tblProducts" layoutX="26.0" layoutY="267.0" prefHeight="127.0" prefWidth="592.0" AnchorPane.leftAnchor="26.0" AnchorPane.rightAnchor="67.0">
            <columns>
                <TableColumn fx:id="colProductId" prefWidth="120.0" text="Product ID" />
                <TableColumn fx:id="colProductName" prefWidth="180.0" text="Product Name" />
                <TableColumn fx:id="colQuantity" prefWidth="120.0" text="Quantity" />
                <TableColumn fx:id="colCost" prefWidth="170.33332316080725" text="Cost" />
            </columns>
        </TableView>
        <Button layoutX="202.0" layoutY="420.0" mnemonicParsing="false" onAction="#btnAddToOrderOnClick" text="Add to Order" AnchorPane.leftAnchor="202.0" />
        <Label fx:id="lblOrderConfirmation" layoutX="195.0" layoutY="493.0" text="Order Status: Waiting..." AnchorPane.leftAnchor="195.0" />

        <!-- event-8: Clicking the "Return Home" button will send the user back to the dashboard -->
        <Button layoutX="517.0" layoutY="502.0" mnemonicParsing="false" onAction="#btnReturnHomeOnClick" text="Return Home" AnchorPane.leftAnchor="517.0" />
      <Button layoutX="317.0" layoutY="420.0" mnemonicParsing="false" onAction="#delete" text="Delete " />
      <Label layoutX="49.0" layoutY="100.0" text="product ID:" />
      <TextField fx:id="roductidTF" layoutX="127.0" layoutY="96.0" />
      <Label layoutX="40.0" layoutY="134.0" text="product name:" />
      <TextField fx:id="productnameTF" layoutX="127.0" layoutY="130.0" />
      <Label layoutX="49.0" layoutY="173.0" text="Quantity" />
      <TextField fx:id="wuantitytF" layoutX="127.0" layoutY="169.0" />
      <Label layoutX="49.0" layoutY="206.0" text="Cost" />
      <TextField fx:id="costtf" layoutX="127.0" layoutY="202.0" />
      <Button layoutX="420.0" layoutY="420.0" mnemonicParsing="false" onAction="#filteringOA" text="Filtering" />

    </children>
</AnchorPane>
