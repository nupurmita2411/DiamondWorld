<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.summer26.section1.group1.diamondworld.Nupur.User8goal4">

    <children>
        <!-- Title Header -->
        <Label layoutX="30.0" layoutY="20.0" text="Customer Feedback Management" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Event 3: TableView to show Feedback ID, Customer Name, Rating, Date -->
        <Label layoutX="30.0" layoutY="55.0" text="Customer Feedback List:" />
        <TableView fx:id="tblFeedback" layoutX="30.0" layoutY="75.0" prefHeight="140.0" prefWidth="590.0">
            <columns>
                <TableColumn fx:id="colFeedbackId" prefWidth="100.0" text="Feedback ID" />
                <TableColumn fx:id="colCustomerName" prefWidth="180.0" text="Customer Name" />
                <TableColumn fx:id="colRating" prefWidth="100.0" text="Rating" />
                <TableColumn fx:id="colDate" prefWidth="208.0" text="Date" />
            </columns>
        </TableView>

        <!-- Event 3: TextArea to display feedback details -->
        <Label layoutX="30.0" layoutY="225.0" text="Feedback Details:" />
        <TextArea fx:id="txtFeedbackDetails" editable="false" layoutX="30.0" layoutY="240.0" prefHeight="25.0" prefWidth="590.0" promptText="Select a feedback row above to view details..." wrapText="true" />

        <!-- Event 3: TextArea for Manager Remarks -->
        <Label layoutX="30.0" layoutY="325.0" text="Manager Remarks:" />
        <TextArea fx:id="txtManagerRemarks" layoutX="30.0" layoutY="345.0" prefHeight="30.0" prefWidth="590.0" promptText="Enter manager remarks or internal notes..." wrapText="true" />

        <!-- Event 3: Button "Mark as Reviewed" -->
        <Button fx:id="btnMarkAsReviewed" layoutX="30.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleMarkAsReviewed" prefHeight="30.0" prefWidth="140.0" text="Mark as Reviewed" />

        <!-- Event 3: Button "Return Home" -->
        <Button fx:id="btnReturnHome" layoutX="185.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleReturnHome" prefHeight="30.0" prefWidth="120.0" text="Return Home" />

        <!-- Event 3: Label to show review status confirmation -->
        <Label fx:id="lblReviewStatus" layoutX="30.0" layoutY="480.0" prefHeight="25.0" prefWidth="590.0" textFill="#008000">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
