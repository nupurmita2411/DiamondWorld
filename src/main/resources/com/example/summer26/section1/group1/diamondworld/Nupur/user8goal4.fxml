<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="575.0" prefWidth="693.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.summer26.section1.group1.diamondworld.Nupur.User8goal4">

    <children>
        <!-- Title Header -->
        <Label layoutX="30.0" layoutY="20.0" text="Customer Feedback Management" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Event 3: TableView to show Feedback ID, Customer Name, Rating, Date -->
        <Label layoutX="30.0" layoutY="55.0" text="Customer Feedback List:" />
        <TableView fx:id="tblFeedback" layoutY="72.0" prefHeight="140.0" prefWidth="693.0">
            <columns>
                <TableColumn fx:id="colFeedbackId" prefWidth="82.6666589975357" text="Feedback ID" />
                <TableColumn fx:id="colCustomerName" prefWidth="110.66670989990234" text="Customer Name" />
                <TableColumn fx:id="colRating" prefWidth="81.33332824707031" text="Rating" />
                <TableColumn fx:id="colDate" minWidth="8.6666259765625" prefWidth="107.3333740234375" text="Date" />
            <TableColumn fx:id="colDetails" prefWidth="308.66667683919275" text="Details" />
            </columns>
        </TableView>

        <!-- Event 3: TextArea for Manager Remarks -->
        <Label layoutX="22.0" layoutY="261.0" text="Manager Remarks:" />
        <TextArea fx:id="txtManagerRemarks" layoutX="10.0" layoutY="300.0" prefHeight="30.0" prefWidth="590.0" promptText="Enter manager remarks or internal notes..." wrapText="true" />

        <!-- Event 3: Button "Mark as Reviewed" -->
        <Button fx:id="btnMarkAsReviewed" layoutX="30.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleMarkAsReviewed" prefHeight="30.0" prefWidth="140.0" text="Mark as Reviewed" />

        <!-- Event 3: Button "Return Home" -->
        <Button fx:id="btnReturnHome" layoutX="185.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleReturnHome" prefHeight="30.0" prefWidth="120.0" text="Return Home" />

        <!-- Event 3: Label to show review status confirmation -->
        <Label fx:id="lblReviewStatus" layoutX="30.0" layoutY="480.0" prefHeight="25.0" prefWidth="590.0" textFill="#008000">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
