<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.StockChecklistController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
        <Label text="Goal 8: Record Daily Physical Counter Stock Checklist" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <Separator/>
    <VBox spacing="8">
        <GridPane hgap="8" vgap="8">
            <Label text="Display Case Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="caseNameField" promptText="Diamond Bangles Display Box C" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Physical Observed Count:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="physicalCountField" promptText="8" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <Button text="Submit &amp; Verify Closure Balance" onAction="#onSubmit" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Separator/>
        <Label text="Daily Stock Checklist Log (Double-click table cells to edit):" style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
        <TableView fx:id="checklistTable" prefHeight="160" editable="true">
            <columns>
                <TableColumn fx:id="caseCol" text="Display Case" prefWidth="180"/>
                <TableColumn fx:id="expectedCol" text="Expected" prefWidth="90"/>
                <TableColumn fx:id="physicalCol" text="Physical" prefWidth="90"/>
                <TableColumn fx:id="diffCol" text="Discrepancy" prefWidth="100"/>
                <TableColumn fx:id="dateCol" text="Date" prefWidth="110"/>
            </columns>
        </TableView>

        <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
            <Label text="Edit / Add Checklist Row:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <HBox spacing="8">
                <Button text="Add Checklist Row" onAction="#onAddRow" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Update Row" onAction="#onUpdateRow" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Delete Row" onAction="#onDeleteRow" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight: bold;"/>
</VBox>
