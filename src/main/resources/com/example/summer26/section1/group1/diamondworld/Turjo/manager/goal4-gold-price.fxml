<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.GoldPriceController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
        <Label text="Goal 4: Update Daily Gold Price per Gram" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <Separator/>
    <VBox spacing="8">
        <GridPane hgap="8" vgap="8">
            <Label text="22K Gold (BDT/g):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="k22Field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="21K Gold (BDT/g):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="k21Field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="18K Gold (BDT/g):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="k18Field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
        <Button text="Update Prices &amp; Recalculate Stock" onAction="#onUpdate" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Separator/>
        <Label text="Gold Price Rate Cards (Double-click table cells to edit):" style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
        <TableView fx:id="priceTable" prefHeight="160" editable="true">
            <columns>
                <TableColumn fx:id="karatCol" text="Karat / Type" prefWidth="180"/>
                <TableColumn fx:id="priceCol" text="Price per Gram (BDT)" prefWidth="180"/>
            </columns>
        </TableView>

        <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
            <Label text="Edit / Add Gold Price Row:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <GridPane hgap="8" vgap="6">
                <Label text="Karat/Type:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="karatInput" promptText="e.g. 24K Pure Gold" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Price/g:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="priceInput" promptText="e.g. 10500" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            </GridPane>
            <HBox spacing="8">
                <Button text="Add Row" onAction="#onAddRow" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Update Row" onAction="#onUpdateRow" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Delete Row" onAction="#onDeleteRow" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight: bold;"/>
</VBox>
