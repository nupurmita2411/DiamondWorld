<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.summer26.section1.group1.diamondworld.Richi.User5Dashboard">

    <children>

        <BorderPane prefHeight="650.0"
                    prefWidth="950.0"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <VBox style="-fx-background-color: #2c3e50;">
                    <children>
                        <Label text="Cashier &amp; Billing Officer Dashboard"
                               textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="22.0"/>
                            </font>
                            <padding>
                                <Insets top="15.0"
                                        bottom="15.0"
                                        left="20.0"/>
                            </padding>
                        </Label>
                    </children>
                </VBox>
            </top>

            <center>
                <GridPane hgap="20.0"
                          vgap="20.0">

                    <padding>
                        <Insets top="30.0"
                                right="30.0"
                                bottom="30.0"
                                left="30.0"/>
                    </padding>

                    <children>
                        <Button text="Goal 1: Generate Customer Bill"
                                prefWidth="260.0"
                                prefHeight="80.0"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0"/>

                        <Button text="Goal 2: Process Customer Payment"
                                prefWidth="260.0"
                                prefHeight="80.0"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0"/>

                        <Button text="Goal 3: Print Purchase Receipt"
                                prefWidth="260.0"
                                prefHeight="80.0"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="0"/>

                        <Button text="Goal 4: View Daily Sales Transactions"
                                prefWidth="260.0"
                                prefHeight="80.0"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1"/>

                        <Button text="Goal 5: Apply Customer Discount"
                                prefWidth="260.0"
                                prefHeight="80.0"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1"/>

                        <Button text="Goal 6: Search Purchase History"
                                prefWidth="260.0"
                                prefHeight="80.0"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="1"/>

                        <Button text="Goal 7: Cancel Incorrect Invoice"
                                prefWidth="260.0"
                                prefHeight="80.0"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="2"/>

                        <Button text="Goal 8: End-of-Day Sales Report"
                                prefWidth="260.0"
                                prefHeight="80.0"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="2"/>
                    </children>

                </GridPane>
            </center>

        </BorderPane>

    </children>

</AnchorPane>