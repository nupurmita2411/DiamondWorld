<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.PaymentProcessingController">

    <!-- Top Section: Header Title & Return Home (Event-8) -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 0 20;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnReturnHome" mnemonicParsing="false" onAction="#handleReturnHome" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="← Return Home" />
                <Label text="Customer Payment Processing Management" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- Center Section: Unpaid Invoices, Payment Form, & Receipt Display -->
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>

                <!-- TableView to Display Unpaid Invoices (Event-3) -->
                <Label text="Select Unpaid Invoice for Payment:" textFill="#34495e">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TableView fx:id="tableUnpaidInvoices" prefHeight="200.0" prefWidth="910.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colInvoiceNo" prefWidth="150.0" text="Invoice No" />
                        <TableColumn fx:id="colCustomerID" prefWidth="150.0" text="Customer ID" />
                        <TableColumn fx:id="colInvoiceDate" prefWidth="150.0" text="Invoice Date" />
                        <TableColumn fx:id="colTotalAmount" prefWidth="180.0" text="Total Amount (BDT)" />
                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Payment Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Lower Split Area: Input Form (Left) & Generated Receipt (Right) -->
                <HBox spacing="20.0" prefHeight="250.0">
                    <children>

                        <!-- Payment Input Form Area (Event-3) -->
                        <VBox spacing="10.0" prefWidth="480.0" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 5;">
                            <children>
                                <Label text="Payment Details" textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>

                                <GridPane hgap="10.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Payment Amount:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtPaymentAmount" promptText="Enter Amount" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Payment Method:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cmbPaymentMethod" prefWidth="200.0" promptText="Select Method" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Payment Reference:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtPaymentRef" promptText="Trx ID / Ref No." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>

                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <padding>
                                        <Insets top="10.0" />
                                    </padding>
                                    <children>
                                        <Button fx:id="btnProcessPayment" mnemonicParsing="false" onAction="#handleProcessPayment" prefHeight="38.0" prefWidth="180.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="Process Payment" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Payment Receipt Area (Event-7) -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fafafa; -fx-padding: 10; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
                            <children>
                                <Label text="Payment Receipt Preview" textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextArea fx:id="txtReceiptView" editable="false" prefHeight="190.0" promptText="Receipt details will be generated here upon successful payment processing..." VBox.vgrow="ALWAYS">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </TextArea>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </center>
</BorderPane>
