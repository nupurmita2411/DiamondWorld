<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.ExpenseApprovalController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
        <Label text="Goal 8: Approve Operational Expense Invoices" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <Separator/>
    <VBox spacing="8">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="Load Invoice Queue" onAction="#onOpenQueue"/>
            <Label text="Pending Invoice:"/>
            <ComboBox fx:id="invoiceCombo" prefWidth="220"/>
            <Label text="Auth Code:"/>
            <TextField fx:id="authCodeField" prefWidth="90" promptText="AUTH1234"/>
            <Button text="Authorize Payment" onAction="#onApprove" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>

        <TextArea fx:id="detailsArea" prefRowCount="3" editable="true" promptText="Invoice details summary (Editable)"/>

        <Separator/>
        <Label text="Operational Expense Queue (Double-click table cells to edit):" style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
        <TableView fx:id="invoiceTable" prefHeight="160" editable="true">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="90"/>
                <TableColumn fx:id="vendorCol" text="Vendor" prefWidth="160"/>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="120"/>
                <TableColumn fx:id="amountCol" text="Amount (BDT)" prefWidth="120"/>
                <TableColumn fx:id="termsCol" text="Service Terms" prefWidth="140"/>
            </columns>
        </TableView>

        <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
            <Label text="Edit / Add Expense Row:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <GridPane hgap="8" vgap="6">
                <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="idInput" promptText="e.g. EXP-101" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Vendor:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="vendorInput" promptText="e.g. Security Systems" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="typeInput" promptText="e.g. Maintenance" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Amount:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="amountInput" promptText="e.g. 45000" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </GridPane>
            <HBox spacing="8">
                <Button text="Add Row" onAction="#onAddRow" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Update Row" onAction="#onUpdateRow" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Delete Row" onAction="#onDeleteRow" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight: bold;"/>
</VBox>
