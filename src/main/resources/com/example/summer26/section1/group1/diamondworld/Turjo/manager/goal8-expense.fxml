<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.ExpenseApprovalController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8">
        <Button text="Back" onAction="#onBack"/>
        <Label text="Goal 8: Approve Operational Expense Invoices" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <VBox spacing="8">
        <Button text="Load Invoice Queue" onAction="#onOpenQueue"/>
        <HBox spacing="8">
            <Label text="Pending Invoice:"/>
            <ComboBox fx:id="invoiceCombo" prefWidth="250"/>
        </HBox>
        <TextArea fx:id="detailsArea" prefRowCount="6" editable="false"/>
        <HBox spacing="8">
            <Label text="Auth Security Code:"/>
            <TextField fx:id="authCodeField" promptText="AUTH1234"/>
            <Button text="Authorize Payment" onAction="#onApprove"/>
        </HBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>

