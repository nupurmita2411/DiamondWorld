<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.summer26.section1.group1.diamondworld.Turjo.CustomOrderController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
        <Label text="Goal 4: Initiate Custom Design Order" style="-fx-font-size:16;-fx-font-weight:bold;"/>
    </HBox>
    <Separator/>
    <VBox spacing="8">
        <GridPane hgap="8" vgap="8">
            <Label text="Customer Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="customerField" promptText="Sadia Rahman" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Metal Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="metalCombo" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Ring Size (3-15):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="ringSizeField" promptText="7.5" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Diamond Cut:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox fx:id="cutCombo" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label text="Advance Deposit (BDT):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="depositField" promptText="30000" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>
        <HBox spacing="8">
            <Button text="Calculate Min Deposit" onAction="#onCalculateDeposit"/>
            <Button text="Submit Order &amp; Issue Ticket" onAction="#onSubmit" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>

        <Separator/>
        <Label text="Custom Design Orders Queue (Double-click table cells to edit):" style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
        <TableView fx:id="orderTable" prefHeight="160" editable="true">
            <columns>
                <TableColumn fx:id="idCol" text="Order ID" prefWidth="90"/>
                <TableColumn fx:id="customerCol" text="Customer" prefWidth="140"/>
                <TableColumn fx:id="metalCol" text="Metal" prefWidth="120"/>
                <TableColumn fx:id="cutCol" text="Diamond Cut" prefWidth="110"/>
                <TableColumn fx:id="sizeCol" text="Ring Size" prefWidth="90"/>
            </columns>
        </TableView>

        <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
            <Label text="Edit / Add Custom Order Row:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <HBox spacing="8">
                <Button text="Add Order Row" onAction="#onAddRow" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Update Row" onAction="#onUpdateRow" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Delete Row" onAction="#onDeleteRow" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight: bold;"/>
</VBox>
