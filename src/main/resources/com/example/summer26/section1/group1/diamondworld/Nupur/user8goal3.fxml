<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.summer26.section1.group1.diamondworld.Nupur.User8goal3">

    <children>
        <!-- Title Header -->
        <Label layoutX="140.0" layoutY="30.0" text="Loyalty Program Management">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Search Customer Section -->
        <TextField fx:id="searchTextField" layoutX="50.0" layoutY="90.0" prefHeight="35.0" prefWidth="360.0" promptText="Enter Customer ID or Name" />
        <Button layoutX="430.0" layoutY="90.0" mnemonicParsing="false" onAction="#handleSearchCustomer" prefHeight="35.0" prefWidth="170.0" text="Search Customer" />

        <!-- Customer Information Section -->
        <Label layoutX="50.0" layoutY="160.0" text="Customer Name:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <Label fx:id="customerNameLabel" layoutX="180.0" layoutY="160.0" text="N/A" />

        <Label layoutX="50.0" layoutY="200.0" text="Membership Tier:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <Label fx:id="membershipTierLabel" layoutX="180.0" layoutY="200.0" text="N/A" />

        <Label layoutX="50.0" layoutY="240.0" text="Current Points:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <Label fx:id="currentPointsLabel" layoutX="180.0" layoutY="240.0" text="0" />

        <!-- Update Points Section -->
        <Label layoutX="50.0" layoutY="310.0" text="Points to Add:" />
        <TextField fx:id="pointsToAddTextField" layoutX="180.0" layoutY="305.0" prefHeight="35.0" prefWidth="230.0" promptText="Enter points amount" />
        <Button layoutX="430.0" layoutY="305.0" mnemonicParsing="false" onAction="#handleUpdatePoints" prefHeight="35.0" prefWidth="170.0" text="Update Points" />

        <!-- Reward Selection Section -->
        <Label layoutX="50.0" layoutY="370.0" text="Reward Selection:" />
        <ComboBox fx:id="rewardComboBox" layoutX="180.0" layoutY="365.0" prefHeight="35.0" prefWidth="230.0" promptText="Select Reward" />
        <Button layoutX="430.0" layoutY="365.0" mnemonicParsing="false" onAction="#handleRedeemReward" prefHeight="35.0" prefWidth="170.0" text="Redeem Reward" />

        <!-- Return Home Button -->
        <Button layoutX="480.0" layoutY="470.0" mnemonicParsing="false" onAction="#handleReturnHome" prefHeight="35.0" prefWidth="120.0" text="Return Home" />
    </children>
</AnchorPane>