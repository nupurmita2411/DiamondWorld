<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.DiscountManagementController">

    <!-- Top Section: Header Title & Return Home Button (Event-8) -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 0 20;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnReturnHome" mnemonicParsing="false" onAction="#handleReturnHome" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="← Return Home" />
                <Label text="Customer Discount Management Panel" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- Center Section: Discount Input Form, Items Table & Recalculated Summary -->
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>

                <!-- Input Form Grid (Event-3) -->
                <GridPane hgap="15.0" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 5;" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Invoice Number:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtInvoiceNumber" promptText="Enter Invoice No" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Customer ID:" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtCustomerID" promptText="Enter Customer ID" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Button fx:id="btnFetchInvoice" mnemonicParsing="false" onAction="#handleFetchInvoice" prefHeight="32.0" prefWidth="130.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="Fetch Invoice" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                    </children>
                </GridPane>

                <!-- TableView to Display Selected Invoice Items -->
                <TableView fx:id="tableInvoiceItems" prefHeight="260.0" prefWidth="910.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colItemCode" prefWidth="140.0" text="Item Code" />
                        <TableColumn fx:id="colItemName" prefWidth="250.0" text="Item Description" />
                        <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Quantity" />
                        <TableColumn fx:id="colUnitPrice" prefWidth="140.0" text="Unit Price (BDT)" />
                        <TableColumn fx:id="colTotalPrice" prefWidth="160.0" text="Total (BDT)" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Bottom Area: Discount Coupon Section (Left) & Recalculated Payable Summary (Right) -->
                <HBox spacing="20.0">
                    <children>

                        <!-- Coupon Code Area (Event-3) -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Discount Code:" textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtDiscountCode" prefHeight="35.0" prefWidth="200.0" promptText="e.g. SAVE20 / PROMO100" />
                                <Button fx:id="btnApplyDiscount" mnemonicParsing="false" onAction="#handleApplyDiscount" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Apply Discount" />
                            </children>
                        </HBox>

                        <!-- Recalculated Summary Panel (Event-6 & Event-7) -->
                        <VBox alignment="TOP_RIGHT" prefWidth="300.0" spacing="5.0" style="-fx-background-color: #2c3e50; -fx-padding: 12; -fx-background-radius: 5;">
                            <children>
                                <Label fx:id="lblSubTotal" text="Subtotal: 0.00 BDT" textFill="WHITE">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblDiscountAmount" text="Discount (-): 0.00 BDT" textFill="#2ecc71">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblTaxAmount" text="Tax (+): 0.00 BDT" textFill="WHITE">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblFinalPayable" text="Final Payable: 0.00 BDT" textFill="#f1c40f">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </center>
</BorderPane>